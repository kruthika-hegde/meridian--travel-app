    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^9.1.0",
    "oxlint": "^1.79.0",
    "vercel": "37.14.0",
    "vite": "6.3.5"
  }
}