{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev --listen 3001 --token %VERCEL_TOKEN%",
    "dev:full": "concurrently -n frontend,api -c blue,magenta \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "26.1.0",
    "oxlint": "^1.79.0",
    "vercel": "37.14.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
