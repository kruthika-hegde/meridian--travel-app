{
  "name": "travel-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev --listen 3001 --token %VERCEL_TOKEN%",
