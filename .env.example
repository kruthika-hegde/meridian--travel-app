# Copy this file to .env and fill in your own keys.
# Never commit the real .env file — it's already in .gitignore.

# https://openweathermap.org/api — free tier is enough
VITE_OPENWEATHER_API_KEY= 

# https://www.pexels.com/api/ — free
VITE_PEXELS_API_KEY= 

# https://aistudio.google.com/apikey — free tier available
VITE_GEMINI_API_KEY= 
